# 1. Aşama: Build (Derleme)
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# API adresini build anında içeri gömüyoruz
ARG VITE_APP_API_URL=https://api-pmm.zeyd.dev
ENV VITE_APP_API_URL=$VITE_APP_API_URL
RUN npm run build

# 2. Aşama: Serve (Yayınlama)
FROM nginx:alpine
# React uygulamasının derlenmiş halini Nginx'e kopyala
COPY --from=build /app/dist /usr/share/nginx/html
# React Router (Sayfa yenilendiğinde 404 vermemesi için) Nginx ayarı
RUN echo 'server { listen 80; location / { root /usr/share/nginx/html; index index.html; try_files $uri $uri/ /index.html; } }' > /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]